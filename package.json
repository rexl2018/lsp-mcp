{
  "name": "lsp-mcp",
  "displayName": "LSP MCP",
  "description": "VS Code extension that provides an LSP MCP server for AI assistants to interact with your development environment",
  "version": "0.1.0",
  "publisher": "rexl2018",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rexl2018/lsp-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rexl2018/lsp-mcp/issues"
  },
  "homepage": "https://github.com/rexl2018/lsp-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vscode",
    "language-server",
    "debugging",
    "ai-assistant",
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:kg.generateGraph",
    "onCommand:kg.exportGraph",
    "onCommand:kg.stopScan"
  ],
  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "lsp-mcp.startServer",
        "title": "Start LSP MCP Server"
      },
      {
        "command": "lsp-mcp.stopServer",
        "title": "Stop LSP MCP Server"
      },
      {
        "command": "lsp-mcp.toggleServer",
        "title": "Toggle LSP MCP Server"
      },
      {
        "command": "kg.generateGraph",
        "title": "KG: Generate Knowledge Graph"
      },
      {
        "command": "kg.exportGraph",
        "title": "KG: Export Knowledge Graph"
      },
      {
        "command": "kg.stopScan",
        "title": "KG: Stop Scan"
      }
    ],
    "configuration": {
      "title": "Knowledge Graph",
      "properties": {
        "kg.excludeTests": {
          "type": "boolean",
          "default": true,
          "description": "是否排除全部测试相关的代码（unit/integration），默认启用。"
        },

        "kg.storageBackend": {
          "type": "string",
          "enum": ["json", "neo4j"],
          "default": "json",
          "description": "知识图存储后端：json（本地文件 .kg/graph.json）或 neo4j（本地 Neo4j 数据库）"
        },

        "kg.neo4j.url": {
          "type": "string",
          "default": "bolt://localhost:7687",
          "description": "Neo4j Bolt URL（通常为本地实例：bolt://localhost:7687）"
        },
        "kg.neo4j.username": {
          "type": "string",
          "default": "neo4j",
          "description": "Neo4j 用户名"
        },
        "kg.neo4j.password": {
          "type": "string",
          "default": "",
          "description": "Neo4j 密码（建议通过 VS Code 用户设置写入，本地开发环境使用）"
        },
        "kg.neo4j.database": {
          "type": "string",
          "default": "neo4j",
          "description": "Neo4j 数据库名称"
        }
      }
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rm -rf out",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^8.57.1",
    "glob": "^11.0.3",
    "mocha": "^11.7.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cors": "^2.8.5",
    "eventsource": "^2.0.2",
    "express": "^5.1.0",
    "neo4j-driver": "^5.18.0"
  }
}
